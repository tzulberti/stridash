# syntax=docker/dockerfile:1.7

# Development image: Node + all workspace dependencies, no application source.
# docker-compose.dev.yml bind-mounts the checkout over /app and keeps the
# installed node_modules in a named volume, so local Node/npm/Prisma are not
# required.

FROM node:22-bookworm-slim

# Prisma downloads/uses an OpenSSL-compatible engine; slim needs these.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=development

COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY apps/mcp/package.json apps/mcp/
COPY apps/mobile/package.json apps/mobile/
COPY packages/types/package.json packages/types/

# Development image: install every workspace so lint/typecheck/tests work in
# the containers too. Mobile is included for tooling only; the cascade starts
# server + web (Expo still belongs on a host/emulator).
RUN npm ci --ignore-scripts \
 && chown -R node:node /app

USER node

EXPOSE 3000 5173

CMD ["npm", "run", "dev", "-w", "@stridash/server"]
