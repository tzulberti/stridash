{
  "name": "stridash",
  "private": true,
  "version": "0.1.0",
  "description": "One dashboard for every stride — open-source fitness aggregator",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "STRIDASH_TEST_REUSE=1 npm test",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "coverage:gate": "node scripts/coverage-gate.mjs",
    "coverage:update": "node scripts/coverage-gate.mjs --update",
    "audit:ci": "node scripts/audit-gate.mjs",
    "openapi:client": "openapi-typescript docs/openapi.json -o packages/types/src/openapi.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "npm run dev -w @stridash/server",
    "dev:mobile": "npm run start -w @stridash/mobile",
    "dev:web": "npm run dev -w @stridash/web",
    "dev:docker": "scripts/docker-dev.sh",
    "dev:docker:down": "scripts/docker-dev.sh down",
    "dev:docker:logs": "scripts/docker-dev.sh logs -f",
    "mcp": "npm run start -w @stridash/mcp",
    "mcp:http": "npm run start:http -w @stridash/mcp",
    "db:up": "docker compose up -d db",
    "db:generate": "npm run prisma:generate -w @stridash/server",
    "db:migrate": "npm run prisma:migrate -w @stridash/server",
    "db:studio": "npm run prisma:studio -w @stridash/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9.18.0",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.74.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/engines@7.10.1": true
  },
  "overrides": {
    "effect": "3.22.5",
    "archiver": "8.0.0",
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    },
    "readdir-glob": {
      "minimatch": "11.0.9"
    }
  }
}
