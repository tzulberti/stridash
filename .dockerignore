.git
.gitignore
.github
node_modules
**/node_modules
**/dist
coverage
coverage/**
*.log

# The production image does not need the mobile app. The dev image only needs
# its package manifest so the root npm workspace install can include tooling.
apps/mobile/*
!apps/mobile/package.json

# Generated by `prisma generate` inside the build stage.
apps/server/src/generated

# Never bake local secrets or editor/OS metadata into an image.
.env
**/.env
**/.env.*
!**/.env.example
.DS_Store
