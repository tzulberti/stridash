// Source of truth: docs/data-model.md — mirrored in packages/types/src/index.ts.
// Plus: docs/db-diagram.md (mermaid ER diagram).
//
// Every primary key is UUIDv7 (native `uuid` column, Prisma's @default(uuid(7))):
// - time-ordered ids → key order == creation order (append-friendly B-trees,
//   and by-date reads for free) without random-UUID index fragmentation
// - native 16-byte `uuid` storage (PostgreSQL 18+ supported end-to-end)
// - generated by the Prisma client itself — no app-level id plumbing

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ───────────────────────────────────────────────────────────────────

enum Sex {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

model User {
  id          String             @id @db.Uuid @default(uuid(7))
  email       String             @unique
  displayName String             @map("display_name")
  heightCm    Decimal?           @map("height_cm") @db.Decimal(4, 1)
  dateOfBirth DateTime?          @map("date_of_birth") @db.Date
  sex         Sex?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  connections    Connection[]
  activities     Activity[]
  measurements   Measurement[]
  gear           Gear[]
  gearComponents GearComponent[]
  authIdentities AuthIdentity[]
  sleepSessions  SleepSession[]
  dailyWellness  DailyWellness[]
  preferences    UserPreferences?
  devices        Device[]

  @@map("users")
}

// ─── User preferences ────────────────────────────────────────────────────────

/// One row per user with a TYPED COLUMN per setting — deliberately not a
/// jsonb blob, so every setting has a Postgres type, a default and a home in
/// the schema. New setting = new column + migration.
enum PrefUnit {
  km
  mi
}

enum PrefTheme {
  dark
  light
}

/// UI languages shipped by the web dashboard — English default.
enum PrefLanguage {
  en
  es
  pt
  fr
  de
  it
  nl
  ru
  ja
  ko
  zh
  hi
}

model UserPreferences {
  id       String       @id @default(uuid(7)) @db.Uuid
  userId   String       @unique @map("user_id") @db.Uuid
  units    PrefUnit     @default(km)
  theme    PrefTheme    @default(dark)
  language PrefLanguage @default(en)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum IdentityKind {
  PASSWORD
}

model AuthIdentity {
  id         String       @id @db.Uuid @default(uuid(7))
  userId     String       @db.Uuid @map("user_id")
  kind       IdentityKind @default(PASSWORD)
  /// Format: "scrypt:$N:$r:$p:$salt_b64:$hash_b64"
  secretHash String       @map("secret_hash")
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_identities")
}

// ─── Connections (external providers) ────────────────────────────────────────

enum Provider {
  STRAVA
  GARMIN
  ZWIFT
  IGPSPORT
  OMRON
  MANUAL
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  REVOKED
}

model Connection {
  id              String           @id @db.Uuid @default(uuid(7))
  userId          String           @db.Uuid @map("user_id")
  provider        Provider
  providerUserId  String           @map("provider_user_id")
  status          ConnectionStatus @default(PENDING)
  /// AES-256-GCM (key from STRIDASH_ENC_KEY env). Never leaves the server.
  accessTokenEnc  String?          @map("access_token_enc")
  refreshTokenEnc String?          @map("refresh_token_enc")
  tokenExpiresAt  DateTime?        @map("token_expires_at") @db.Timestamptz(6)
  scopes          String[]         @default([])
  /// Provider-specific connection config (e.g. Omron country code +
  /// registration metadata). Contains no secrets — tokens live encrypted above.
  config          Json?
  lastSyncedAt    DateTime?        @map("last_synced_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncLogs     SyncLog[]
  activities   ActivitySource[]
  measurements Measurement[]
  sleep        SleepSession[]
  dailyWellness DailyWellness[]

  @@index([userId])
  @@unique([userId, provider, providerUserId])
  @@map("connections")
}

enum SyncKind {
  ACTIVITIES
  MEASUREMENTS
  WELLNESS
  TOKEN_REFRESH
}

enum SyncStatus {
  OK
  PARTIAL
  ERROR
}

model SyncLog {
  id           String     @id @db.Uuid @default(uuid(7))
  connectionId String     @db.Uuid @map("connection_id")
  kind         SyncKind
  status       SyncStatus
  itemsPulled  Int        @default(0) @map("items_pulled")
  itemsCreated Int        @default(0) @map("items_created")
  itemsUpdated Int        @default(0) @map("items_updated")
  errorDetail  Json?      @map("error_detail")
  startedAt    DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?  @map("finished_at") @db.Timestamptz(6)

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@map("sync_logs")
}

// ─── Wellness (nightly sleep + daily wearer metrics) ─────────────────────────

/// One night of sleep as the source device recorded it. The sleep window
/// usually crosses midnight — `dateKey` is the wearer's LOCAL calendar date
/// the window ENDED on (Garmin's calendarDate), the same key the watch shows.
model SleepSession {
  id           String   @id @db.Uuid @default(uuid(7))
  userId       String   @db.Uuid @map("user_id")
  connectionId String   @db.Uuid @map("connection_id")
  provider     Provider
  dateKey      String   @map("date_key")
  /// actual sleep window (pauses included, naps excluded)
  startAt      DateTime @map("start_at") @db.Timestamptz(6)
  endAt        DateTime? @map("end_at") @db.Timestamptz(6)
  /// stage seconds sum to ≤ totalSleepS when some time was unmeasurable
  totalSleepS  Int?     @map("total_sleep_s")
  deepS        Int?     @map("deep_s")
  lightS       Int?     @map("light_s")
  remS         Int?     @map("rem_s")
  awakeS       Int?     @map("awake_s")
  napS         Int?     @map("nap_s")
  awakeCount   Int?     @map("awake_count")
  avgSleepStress Decimal? @map("avg_sleep_stress") @db.Decimal(5, 1)
  avgHr        Int?     @map("avg_hr")
  avgRespiration Decimal? @map("avg_respiration") @db.Decimal(4, 1)
  restingHr    Int?     @map("resting_hr")
  /// Gen-5+ watch tracks overnight HRV: BALANCED / LOW / UNBALANCED / HIGH
  hrvStatus    String?
  hrvAvg       Decimal? @map("hrv_avg") @db.Decimal(5, 1)
  /// body-battery gained awake − drained asleep over the window
  bodyBatteryChange Int? @map("body_battery_change")
  /// watch's suggested sleep need, minutes
  sleepNeedMin Int?     @map("sleep_need_min")
  /// device-computed overall night score (0-100)
  sleepScore   Int?     @map("sleep_score")
  raw          Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, dateKey])
  @@index([userId, dateKey])
  @@map("sleep_sessions")
}

/// One wearer-day of non-activity metrics (steps, floors, calories, stress,
/// body battery, resting HR...). Keyed the same way as SleepSession.
model DailyWellness {
  id            String  @id @db.Uuid @default(uuid(7))
  userId        String  @db.Uuid @map("user_id")
  connectionId  String  @db.Uuid @map("connection_id")
  provider      Provider
  dateKey       String  @map("date_key")
  steps         Int?
  stepsGoal     Int?    @map("steps_goal")
  distanceM     Decimal? @map("distance_m") @db.Decimal(8, 1)
  floorsAsc     Int?    @map("floors_asc")
  floorsDesc    Int?    @map("floors_desc")
  activeCal     Int?    @map("active_cal")
  restingCal    Int?    @map("resting_cal")
  totalCal      Int?    @map("total_cal")
  hrMin         Int?    @map("hr_min")
  hrMax         Int?    @map("hr_max")
  restingHr     Int?    @map("resting_hr")
  moderateMin   Int?    @map("moderate_min")
  vigorousMin   Int?    @map("vigorous_min")
  intensityGoal Int?    @map("intensity_goal")
  stressAvg     Float?  @map("stress_avg")
  stressMax     Float?  @map("stress_max")
  batteryMin    Int?    @map("battery_min")
  batteryMax    Int?    @map("battery_max")
  batteryLatest Int?    @map("battery_latest")
  raw           Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, dateKey])
  @@index([userId, dateKey])
  @@map("daily_wellness")
}

// ─── Activities ──────────────────────────────────────────────────────────────

enum ActivityType {
  RUN
  RIDE
  VIRTUAL_RIDE
  WALK
  HIKE
  SWIM
  WORKOUT
  OTHER
}

model Activity {
  id           String       @id @db.Uuid @default(uuid(7))
  userId       String       @db.Uuid @map("user_id")
  headline     String
  /// Zwift workout identity ("Zwift - <workout>"), null for free rides and
  /// other providers
  workoutName  String?      @map("workout_name")
  type         ActivityType
  /// Dedup key component — see docs/data-model.md
  startTime    DateTime     @map("start_time") @db.Timestamptz(6)
  durationS    Int          @map("duration_s")
  movingTimeS  Int?         @map("moving_time_s")
  // — performance: distance / speed —
  distanceM    Decimal?     @map("distance_m") @db.Decimal(10, 2)
  avgSpeedMs   Decimal?     @map("avg_speed_ms") @db.Decimal(6, 2)
  maxSpeedMs   Decimal?     @map("max_speed_ms") @db.Decimal(6, 2)
  // — performance: terrain —
  totalAscentM Decimal?     @map("total_ascent_m") @db.Decimal(8, 2)
  totalDescentM Decimal?    @map("total_descent_m") @db.Decimal(8, 2)
  elevationHighM Decimal?   @map("elevation_high_m") @db.Decimal(7, 2)
  elevationLowM  Decimal?   @map("elevation_low_m") @db.Decimal(7, 2)
  // — performance: heart rate / zones —
  avgHr        Int?         @map("avg_hr")
  maxHr        Int?         @map("max_hr")
  /// minutes per HR zone (index 0 = zone 1), source-reported when available
  hrZonesMin   Json?        @map("hr_zones_min")
  // — performance: power / cadence —
  avgPowerW    Int?         @map("avg_power_w")
  maxPowerW    Int?         @map("max_power_w")
  avgCadence   Int?         @map("avg_cadence")
  maxCadence   Int?         @map("max_cadence")
  // — performance: effort / load —
  caloriesKcal Int?         @map("calories_kcal")
  /// Source-reported training load / stress (TSS-like); semantics vary by
  /// provider — the raw payload is the authority
  trainingLoad Int?         @map("training_load")
  // — physiology (Garmin Connect list row + FIT session; null elsewhere) —
  /// Connect-computed estimated sweat loss (mL; "waterEstimated")
  sweatLossMl  Float?       @map("sweat_loss_ml")
  /// Firstbeat aerobic / anaerobic training effect (0–5)
  aerobicTe    Float?       @map("aerobic_te")
  anaerobicTe  Float?       @map("anaerobic_te")
  /// Benefit codes as-received (e.g. "IMPROVING_LACTATE_THRESHOLD_12");
  /// beautified client-side
  aerobicTeMessage   String? @map("aerobic_te_message")
  anaerobicTeMessage String? @map("anaerobic_te_message")
  /// Session-detected VO2max estimate (mL/kg/min)
  vo2max       Float?       @map("vo2max")
  /// FIT recovery_time — minutes until the next hard effort is sensible
  recoveryMinutes    Float? @map("recovery_minutes")
  normalizedPowerW   Float? @map("normalized_power_w")
  indoor       Boolean      @default(false)
  gearId       String?      @db.Uuid @map("gear_id")
  /// Recording device (watch / cycling head unit), nullable — backfilled by
  /// sync passes for activities ingested before devices were tracked
  deviceId     String?      @db.Uuid @map("device_id")
  notes        String?
  raw          Json?
  /// provider detail-endpoint payload as-received (e.g. Zwift's
  /// /api/activities/:id); null for providers with no richer endpoint than
  /// the list row (iGPSPORT's FIT already lives in the series table)
  detailRaw    Json?        @map("detail_raw")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  gear       Gear?               @relation(fields: [gearId], references: [id], onDelete: SetNull)
  device     Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  sources    ActivitySource[]
  dataPoints ActivityDataPoint[]

  @@index([userId, startTime])
  @@unique([userId, startTime, type, distanceM])
  @@map("activities")
}

/// Per-sample performance series for an activity (the FIT/GPX "stream").
/// One row per (activity, provider): arrays live in `series` jsonb —
/// { timeMs: [], latDeg: [], lngDeg: [], distanceM: [], altitudeM: [],
///   speedMs: [], hrBpm: [], cadenceRpm: [], powerW: [], temperatureC: [] } —
/// every chart an app ever draws fetches just this one row.
model ActivityDataPoint {
  id          String   @id @db.Uuid @default(uuid(7))
  /// Dedup key component
  activityId  String   @map("activity_id") @db.Uuid
  /// Which provider's series this is (an activity can arrive via Garmin AND
  /// Strava with different streams; the richest set wins, others are kept
  /// for provenance)
  provider    Provider
  sampleCount Int      @map("sample_count")
  series      Json
  raw         Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, provider])
  @@map("activity_data_points")
}

model ActivitySource {
  activityId       String   @db.Uuid @map("activity_id")
  connectionId     String   @db.Uuid @map("connection_id")
  sourceActivityId String   @map("source_activity_id")
  sourceUpdatedAt  DateTime @map("source_updated_at") @db.Timestamptz(6)

  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([activityId, connectionId])
  @@map("activity_sources")
}

// ─── Devices (recording hardware) ────────────────────────────────────────────

/// Physical devices that record activities — watches (Garmin) and cycling
/// head units (iGPSPORT). Dedup key: (user_id, provider, source_device_id),
/// where the source id is the FIT device message's serial number. The
/// friendly model name resolves from the provider when it can (Garmin's
/// device-registration endpoint); Zwift/Omron have no per-activity device.
model Device {
  id              String   @id @db.Uuid @default(uuid(7))
  userId          String   @db.Uuid @map("user_id")
  provider        Provider
  sourceDeviceId  String   @map("source_device_id")
  /// "garmin" / "igpsport" — FIT manufacturer enum as-received
  manufacturer    String?
  /// friendly display name when the provider resolves it ("Forerunner 955 Solar")
  model           String?
  /// FIT product code (numeric, e.g. 4024) — provider-specific vocabulary
  productCode     Int?     @map("product_code")
  /// latest firmware seen on any activity from this device
  softwareVersion String?  @map("software_version")
  hardwareVersion String?  @map("hardware_version")
  /// the FIT device message / provider payload as-received
  raw             Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([userId, provider, sourceDeviceId])
  @@map("devices")
}

// ─── Gear ────────────────────────────────────────────────────────────────────

enum GearKind {
  BIKE
  SHOES
  OTHER
}

model Gear {
  id     String   @id @default(uuid(7)) @db.Uuid
  userId String   @map("user_id") @db.Uuid
  name   String
  kind   GearKind @default(OTHER)
  brand  String?
  model  String?
  /// Which provider this row came from (null = added manually in Stridash).
  /// GARMIN rows come from gear-service v2 (uuid, usageType, threshold,
  /// firstUseDate, ACTIVE/RETIRED status) — synced at activity sync time.
  provider     Provider?
  /// Provider's gear id (e.g. Garmin's dashed gear uuid) — dedup key with
  /// (userId, provider); null for manual gear
  sourceGearId String?   @map("source_gear_id")
  /// date the provider says the gear was first used
  firstUsedAt  DateTime? @map("first_used_at") @db.Date
  /// null = still in use
  retiredAt    DateTime? @map("retired_at") @db.Date
  /// How the provider counts usage ("DISTANCE" / "TIME")
  usageType    String?   @map("usage_type")
  /// Provider-reported retirement threshold (Garmin's maxUsageDistanceMeters)
  thresholdM   Decimal?  @map("threshold_m") @db.Decimal(10, 1)
  /// Provider payload as-received ("raw payload is the authority" policy)
  raw          Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]
  components GearComponent[]

  @@index([userId])
  @@unique([userId, provider, sourceGearId])
  @@map("gear")
}

/// A wear item mounted on a piece of gear (chain, brake pads, tires, shoe
/// insoles…). Garmin has no component concept — components are managed in
/// Stridash, and their usage is COMPUTED from the activities linked to the
/// parent gear (activities.gear_id) that start on/after `installedAt`
/// (docs/data-model.md "Usage" section).
enum GearComponentKind {
  CHAIN
  CASSETTE
  CHAINRING
  BRAKE_PADS
  TIRES
  TUBES
  PEDALS
  BATTERY
  OTHER
}

model GearComponent {
  id     String            @id @default(uuid(7)) @db.Uuid
  userId String            @map("user_id") @db.Uuid
  gearId String            @map("gear_id") @db.Uuid
  name   String
  kind   GearComponentKind @default(OTHER)
  /// Usage counts activities that START on/after this date; null = unknown
  /// install odometer → usage stays 0 until the date is set
  installedAt DateTime?   @map("installed_at") @db.Date
  /// null = still mounted
  retiredAt   DateTime?   @map("retired_at") @db.Date
  /// User's own replacement threshold in meters (advisory — shown as %)
  thresholdM  Decimal?    @map("threshold_m") @db.Decimal(10, 1)
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gear Gear @relation(fields: [gearId], references: [id], onDelete: Cascade)

  @@index([gearId])
  @@index([userId])
  @@map("gear_components")
}

// ─── Measurements ────────────────────────────────────────────────────────────

enum MeasurementKind {
  WEIGH_IN
  BLOOD_PRESSURE
}

model Measurement {
  id                    String          @id @db.Uuid @default(uuid(7))
  userId                String          @db.Uuid @map("user_id")
  /// null = manual entry in Stridash
  connectionId          String?         @db.Uuid @map("connection_id")
  kind                  MeasurementKind
  /// Dedup key component — see docs/data-model.md
  measuredAt            DateTime        @map("measured_at") @db.Timestamptz(6)
  // — WEIGH_IN —
  weightKg              Decimal?        @map("weight_kg") @db.Decimal(6, 2)
  bodyFatPct            Decimal?        @map("body_fat_pct") @db.Decimal(5, 2)
  muscleMassKg          Decimal?        @map("muscle_mass_kg") @db.Decimal(6, 2)
  skeletalMusclePct     Decimal?        @map("skeletal_muscle_pct") @db.Decimal(5, 2)
  bmi                   Decimal?        @db.Decimal(5, 2)
  /// Omron code 264 (one decimal on the 702T generation ⇒ not an Int)
  visceralFatLevel      Decimal?        @map("visceral_fat_level") @db.Decimal(4, 1)
  restingMetabolismKcal Int?            @map("resting_metabolism_kcal")
  metabolicAge          Int?            @map("metabolic_age")
  /// Omron code 281
  subcutaneousFatPct    Decimal?        @map("subcutaneous_fat_pct") @db.Decimal(5, 2)
  /// Omron code 268
  fatFreeMassKg         Decimal?        @map("fat_free_mass_kg") @db.Decimal(6, 2)
  /// Omron code 295
  fatMassKg             Decimal?        @map("fat_mass_kg") @db.Decimal(6, 2)
  /// Omron code 294
  skeletalMuscleMassKg  Decimal?        @map("skeletal_muscle_mass_kg") @db.Decimal(6, 2)
  /// Omron code 267 — raw BIA reading
  impedanceOhm          Decimal?        @map("impedance_ohm") @db.Decimal(6, 2)
  bodyWaterPct          Decimal?        @map("body_water_pct") @db.Decimal(5, 2)
  boneMassKg            Decimal?        @map("bone_mass_kg") @db.Decimal(6, 2)
  // — BLOOD_PRESSURE —
  systolicMmhg          Int?            @map("systolic_mmhg")
  diastolicMmhg         Int?            @map("diastolic_mmhg")
  pulseBpm              Int?            @map("pulse_bpm")
  /// Omron code 16
  meanArterialPressure  Decimal?        @map("mean_arterial_pressure") @db.Decimal(5, 2)
  // — meta —
  notes                 String?
  /// Segmental body composition (Omron codes 275–288) — shape in docs/data-model.md
  segments              Json?
  raw                   Json?
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([connectionId, kind, measuredAt])
  @@index([userId, measuredAt])
  @@map("measurements")
}
