// Source of truth: docs/data-model.md — mirrored in packages/types/src/index.ts.
// Plus: docs/db-diagram.md (mermaid ER diagram).
//
// Every primary key is UUIDv7 (native `uuid` column, Prisma's @default(uuid(7))):
// - time-ordered ids → key order == creation order (append-friendly B-trees,
//   and by-date reads for free) without random-UUID index fragmentation
// - native 16-byte `uuid` storage (PostgreSQL 18+ supported end-to-end)
// - generated by the Prisma client itself — no app-level id plumbing

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ───────────────────────────────────────────────────────────────────

enum Sex {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

model User {
  id          String             @id @db.Uuid @default(uuid(7))
  email       String             @unique
  displayName String             @map("display_name")
  heightCm    Decimal?           @map("height_cm") @db.Decimal(4, 1)
  dateOfBirth DateTime?          @map("date_of_birth") @db.Date
  sex         Sex?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  connections    Connection[]
  activities     Activity[]
  measurements   Measurement[]
  gear           Gear[]
  authIdentities AuthIdentity[]

  @@map("users")
}

enum IdentityKind {
  PASSWORD
}

model AuthIdentity {
  id         String       @id @db.Uuid @default(uuid(7))
  userId     String       @db.Uuid @map("user_id")
  kind       IdentityKind @default(PASSWORD)
  /// Format: "scrypt:$N:$r:$p:$salt_b64:$hash_b64"
  secretHash String       @map("secret_hash")
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_identities")
}

// ─── Connections (external providers) ────────────────────────────────────────

enum Provider {
  STRAVA
  GARMIN
  ZWIFT
  IGPSPORT
  OMRON
  MANUAL
}

enum ConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  REVOKED
}

model Connection {
  id              String           @id @db.Uuid @default(uuid(7))
  userId          String           @db.Uuid @map("user_id")
  provider        Provider
  providerUserId  String           @map("provider_user_id")
  status          ConnectionStatus @default(PENDING)
  /// AES-256-GCM (key from STRIDASH_ENC_KEY env). Never leaves the server.
  accessTokenEnc  String?          @map("access_token_enc")
  refreshTokenEnc String?          @map("refresh_token_enc")
  tokenExpiresAt  DateTime?        @map("token_expires_at") @db.Timestamptz(6)
  scopes          String[]         @default([])
  /// Provider-specific connection config (e.g. Omron country code +
  /// registration metadata). Contains no secrets — tokens live encrypted above.
  config          Json?
  lastSyncedAt    DateTime?        @map("last_synced_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncLogs     SyncLog[]
  activities   ActivitySource[]
  measurements Measurement[]

  @@index([userId])
  @@unique([userId, provider, providerUserId])
  @@map("connections")
}

enum SyncKind {
  ACTIVITIES
  MEASUREMENTS
  TOKEN_REFRESH
}

enum SyncStatus {
  OK
  PARTIAL
  ERROR
}

model SyncLog {
  id           String     @id @db.Uuid @default(uuid(7))
  connectionId String     @db.Uuid @map("connection_id")
  kind         SyncKind
  status       SyncStatus
  itemsPulled  Int        @default(0) @map("items_pulled")
  itemsCreated Int        @default(0) @map("items_created")
  itemsUpdated Int        @default(0) @map("items_updated")
  errorDetail  Json?      @map("error_detail")
  startedAt    DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?  @map("finished_at") @db.Timestamptz(6)

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@map("sync_logs")
}

// ─── Activities ──────────────────────────────────────────────────────────────

enum ActivityType {
  RUN
  RIDE
  VIRTUAL_RIDE
  WALK
  HIKE
  SWIM
  WORKOUT
  OTHER
}

model Activity {
  id           String       @id @db.Uuid @default(uuid(7))
  userId       String       @db.Uuid @map("user_id")
  headline     String
  type         ActivityType
  /// Dedup key component — see docs/data-model.md
  startTime    DateTime     @map("start_time") @db.Timestamptz(6)
  durationS    Int          @map("duration_s")
  movingTimeS  Int?         @map("moving_time_s")
  // — performance: distance / speed —
  distanceM    Decimal?     @map("distance_m") @db.Decimal(10, 2)
  avgSpeedMs   Decimal?     @map("avg_speed_ms") @db.Decimal(6, 2)
  maxSpeedMs   Decimal?     @map("max_speed_ms") @db.Decimal(6, 2)
  // — performance: terrain —
  totalAscentM Decimal?     @map("total_ascent_m") @db.Decimal(8, 2)
  totalDescentM Decimal?    @map("total_descent_m") @db.Decimal(8, 2)
  elevationHighM Decimal?   @map("elevation_high_m") @db.Decimal(7, 2)
  elevationLowM  Decimal?   @map("elevation_low_m") @db.Decimal(7, 2)
  // — performance: heart rate / zones —
  avgHr        Int?         @map("avg_hr")
  maxHr        Int?         @map("max_hr")
  /// minutes per HR zone (index 0 = zone 1), source-reported when available
  hrZonesMin   Json?        @map("hr_zones_min")
  // — performance: power / cadence —
  avgPowerW    Int?         @map("avg_power_w")
  maxPowerW    Int?         @map("max_power_w")
  avgCadence   Int?         @map("avg_cadence")
  maxCadence   Int?         @map("max_cadence")
  // — performance: effort / load —
  caloriesKcal Int?         @map("calories_kcal")
  /// Source-reported training load / stress (TSS-like); semantics vary by
  /// provider — the raw payload is the authority
  trainingLoad Int?         @map("training_load")
  indoor       Boolean      @default(false)
  gearId       String?      @db.Uuid @map("gear_id")
  notes        String?
  raw          Json?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  gear       Gear?               @relation(fields: [gearId], references: [id], onDelete: SetNull)
  sources    ActivitySource[]
  dataPoints ActivityDataPoint[]

  @@index([userId, startTime])
  @@unique([userId, startTime, type, distanceM])
  @@map("activities")
}

/// Per-sample performance series for an activity (the FIT/GPX "stream").
/// One row per (activity, provider): arrays live in `series` jsonb —
/// { timeMs: [], latDeg: [], lngDeg: [], distanceM: [], altitudeM: [],
///   speedMs: [], hrBpm: [], cadenceRpm: [], powerW: [], temperatureC: [] } —
/// every chart an app ever draws fetches just this one row.
model ActivityDataPoint {
  id          String   @id @db.Uuid @default(uuid(7))
  /// Dedup key component
  activityId  String   @map("activity_id") @db.Uuid
  /// Which provider's series this is (an activity can arrive via Garmin AND
  /// Strava with different streams; the richest set wins, others are kept
  /// for provenance)
  provider    Provider
  sampleCount Int      @map("sample_count")
  series      Json
  raw         Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, provider])
  @@map("activity_data_points")
}

model ActivitySource {
  activityId       String   @db.Uuid @map("activity_id")
  connectionId     String   @db.Uuid @map("connection_id")
  sourceActivityId String   @map("source_activity_id")
  sourceUpdatedAt  DateTime @map("source_updated_at") @db.Timestamptz(6)

  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([activityId, connectionId])
  @@map("activity_sources")
}

// ─── Gear ────────────────────────────────────────────────────────────────────

enum GearKind {
  BIKE
  SHOES
  OTHER
}

model Gear {
  id        String   @id @db.Uuid @default(uuid(7))
  userId    String   @db.Uuid @map("user_id")
  name      String
  kind      GearKind @default(OTHER)
  brand     String?
  model     String?
  retired   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([userId])
  @@map("gear")
}

// ─── Measurements ────────────────────────────────────────────────────────────

enum MeasurementKind {
  WEIGH_IN
  BLOOD_PRESSURE
}

model Measurement {
  id                    String          @id @db.Uuid @default(uuid(7))
  userId                String          @db.Uuid @map("user_id")
  /// null = manual entry in Stridash
  connectionId          String?         @db.Uuid @map("connection_id")
  kind                  MeasurementKind
  /// Dedup key component — see docs/data-model.md
  measuredAt            DateTime        @map("measured_at") @db.Timestamptz(6)
  // — WEIGH_IN —
  weightKg              Decimal?        @map("weight_kg") @db.Decimal(6, 2)
  bodyFatPct            Decimal?        @map("body_fat_pct") @db.Decimal(5, 2)
  muscleMassKg          Decimal?        @map("muscle_mass_kg") @db.Decimal(6, 2)
  skeletalMusclePct     Decimal?        @map("skeletal_muscle_pct") @db.Decimal(5, 2)
  bmi                   Decimal?        @db.Decimal(5, 2)
  /// Omron code 264 (one decimal on the 702T generation ⇒ not an Int)
  visceralFatLevel      Decimal?        @map("visceral_fat_level") @db.Decimal(4, 1)
  restingMetabolismKcal Int?            @map("resting_metabolism_kcal")
  metabolicAge          Int?            @map("metabolic_age")
  /// Omron code 281
  subcutaneousFatPct    Decimal?        @map("subcutaneous_fat_pct") @db.Decimal(5, 2)
  /// Omron code 268
  fatFreeMassKg         Decimal?        @map("fat_free_mass_kg") @db.Decimal(6, 2)
  /// Omron code 295
  fatMassKg             Decimal?        @map("fat_mass_kg") @db.Decimal(6, 2)
  /// Omron code 294
  skeletalMuscleMassKg  Decimal?        @map("skeletal_muscle_mass_kg") @db.Decimal(6, 2)
  /// Omron code 267 — raw BIA reading
  impedanceOhm          Decimal?        @map("impedance_ohm") @db.Decimal(6, 2)
  bodyWaterPct          Decimal?        @map("body_water_pct") @db.Decimal(5, 2)
  boneMassKg            Decimal?        @map("bone_mass_kg") @db.Decimal(6, 2)
  // — BLOOD_PRESSURE —
  systolicMmhg          Int?            @map("systolic_mmhg")
  diastolicMmhg         Int?            @map("diastolic_mmhg")
  pulseBpm              Int?            @map("pulse_bpm")
  /// Omron code 16
  meanArterialPressure  Decimal?        @map("mean_arterial_pressure") @db.Decimal(5, 2)
  // — meta —
  notes                 String?
  /// Segmental body composition (Omron codes 275–288) — shape in docs/data-model.md
  segments              Json?
  raw                   Json?
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([connectionId, kind, measuredAt])
  @@index([userId, measuredAt])
  @@map("measurements")
}
