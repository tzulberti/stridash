# Stridash server environment.
# Copy to .env (git-ignored) — docker-compose.yml provides matching defaults
# for the local Postgres.

# Postgres connection (matches docker-compose.yml "db" service)
DATABASE_URL="postgresql://stridash:stridash@localhost:5433/stridash?schema=public"

# Secret used to sign app JWTs (access + refresh). Required.
# Generate: openssl rand -hex 32
STRIDASH_JWT_SECRET="change-me"

# Key used to encrypt provider tokens at rest (AES-256-GCM). Required.
# Generate: openssl rand -hex 32
STRIDASH_ENC_KEY="change-me"
# Optional: a separate key for provider credentials (tokens + stored
# iGPSPORT passwords). New writes use it; legacy v1 rows still use
# STRIDASH_ENC_KEY. Generate: openssl rand -hex 32
# STRIDASH_PROVIDER_ENC_KEY=""
# Stable ids recorded in v2 ciphertext (1-32 chars: A-Z a-z 0-9 . _ -).
# STRIDASH_ENC_KEY_ID="app-v1"
# STRIDASH_PROVIDER_ENC_KEY_ID="provider-v1"
# KDF salt for new v2 writes. Generate: openssl rand -base64 16
# If unset, a random per-process salt is used (v2 embeds it). v1 reads always
# use the legacy fixed salt.
# STRIDASH_ENC_SALT=""
# JSON map of retired id -> key, decrypt-only. Keep a previous key here while
# re-encrypting, then remove it. Run: npm run crypto:reencrypt -w @stridash/server
# STRIDASH_ENC_OLD_KEYS='{"provider-old":"..."}'

# Server port (default 3000)
PORT="3000"

# ─── Auth rate limiting ──────────────────────────────────────────────────────
# Per-IP budget for /api/auth/* (register, login, refresh, logout).
STRIDASH_AUTH_RATE_LIMIT="30"
STRIDASH_AUTH_RATE_WINDOW_MS="900000"
# Registration attempts per IP within one window. Registration currently
# reveals whether an email exists (accepted risk, see docs/risks-todo.md S5),
# so keep this low enough to make mass enumeration expensive.
STRIDASH_REGISTER_RATE_LIMIT="10"
# Per-email login attempts within one window (password-guessing cap).
STRIDASH_LOGIN_RATE_LIMIT="10"
# Per-user connection attempts within one window. Repeated bad provider
# logins can lock the user's Garmin/Zwift account, so cap retries.
STRIDASH_CONNECTION_RATE_LIMIT="10"
STRIDASH_CONNECTION_RATE_WINDOW_MS="900000"
# Set to "true" ONLY behind a reverse proxy that overwrites X-Forwarded-For;
# otherwise clients can spoof the header and bypass the per-IP limit.
STRIDASH_TRUST_PROXY="false"
