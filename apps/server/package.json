{
  "name": "@stridash/server",
  "version": "0.1.0",
  "description": "Stridash API server: REST API, sync engine, scheduler",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx --env-file=.env watch src/index.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "crypto:reencrypt": "tsx --env-file=.env src/scripts/reencrypt-tokens.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "start:prod": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "data:merge-activities": "tsx --env-file=.env src/scripts/merge-duplicate-activities.ts",
    "openapi:generate": "tsx src/scripts/write-openapi.ts",
    "strava:webhook": "tsx --env-file=.env src/scripts/strava-webhook.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@stridash/types": "*",
    "fit-file-parser": "^6.2.7",
    "hono": "^4.6.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.10.5",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
