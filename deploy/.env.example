# Copy to deploy/.env and keep it out of git.
#   cp deploy/.env.example deploy/.env
# Generate the two required secrets with: openssl rand -hex 32

# Public hostname Caddy obtains a certificate for. DNS must point here first.
STRIDASH_DOMAIN=stridash.example.com

POSTGRES_USER=stridash
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32
POSTGRES_DB=stridash

STRIDASH_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
STRIDASH_ENC_KEY=change-me-generate-with-openssl-rand-hex-32
STRIDASH_VERSION=0.1.0

# Optional provider-credential key. New writes use it; legacy v1 rows still
# decrypt with STRIDASH_ENC_KEY. Generate another value with openssl rand -hex 32.
# STRIDASH_PROVIDER_ENC_KEY=
# STRIDASH_ENC_KEY_ID=app-v1
# STRIDASH_PROVIDER_ENC_KEY_ID=provider-v1
# STRIDASH_ENC_SALT=
# STRIDASH_ENC_OLD_KEYS={"provider-old":"..."}

# Auth / connection rate limits (the server defaults are fine for one user).
# STRIDASH_AUTH_RATE_LIMIT=30
# STRIDASH_AUTH_RATE_WINDOW_MS=900000
# STRIDASH_REGISTER_RATE_LIMIT=10
# STRIDASH_LOGIN_RATE_LIMIT=10
# STRIDASH_CONNECTION_RATE_LIMIT=10
# STRIDASH_CONNECTION_RATE_WINDOW_MS=900000
# Per-user manual sync triggers and API-token cap.
# STRIDASH_SYNC_RATE_LIMIT=30
# STRIDASH_SYNC_RATE_WINDOW_MS=900000
# STRIDASH_MAX_API_TOKENS=20

# Background sync: every 15 minutes, up to 10 connections per tick.
# Set the interval to 0 to disable automatic sync (manual "sync now" only).
# STRIDASH_SYNC_INTERVAL_MS=900000
# STRIDASH_SYNC_BATCH_SIZE=10

# Strava OAuth app (https://www.strava.com/settings/api). The callback URL
# configured there must match STRIDASH_STRAVA_REDIRECT_URI (or
# https://$STRIDASH_DOMAIN/api/strava/callback by default).
# STRIDASH_STRAVA_CLIENT_ID=
# STRIDASH_STRAVA_CLIENT_SECRET=
# STRIDASH_STRAVA_REDIRECT_URI=https://stridash.example.com/api/strava/callback
# STRIDASH_STRAVA_WEBHOOK_VERIFY_TOKEN=
# STRIDASH_STRAVA_BACKFILL_DAYS=365
# STRIDASH_PUBLIC_URL=https://stridash.example.com

# Garmin weight / blood-pressure first-sync history window (days).
# STRIDASH_GARMIN_HEALTH_BACKFILL_DAYS=365
